{
  "name": "csharp-smart-semicolon",
  "displayName": "C# Smart Semicolon",
  "description": "Rider-like smart semicolon: typing ';' inside parentheses moves it to the end of the line.",
  "version": "0.1.0",
  "publisher": "Saix93",
  "author": "Raúl Torres González",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/saix93/vscode-smart-semicolon.git"
  },
  "bugs": {
    "url": "https://github.com/saix93/vscode-smart-semicolon/issues"
  },
  "homepage": "https://github.com/saix93/vscode-smart-semicolon#readme",
  "engines": {
    "vscode": "^1.64.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "csharp",
    "c#",
    "unity",
    "rider",
    "semicolon"
  ],
  "activationEvents": [
    "onLanguage:csharp"
  ],
  "main": "./out/extension.js",
  "contributes": {},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && npm run test:unit && npm run test:integration",
    "package": "vsce package",
    "deploy": "vsce publish",
    "test:unit": "mocha \"out/test/unit/**/*.test.js\"",
    "test:integration": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "1.64.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "mocha": "^12.0.3",
    "typescript": "^5.4.0"
  }
}
